#!/usr/bin/env bash
# Spell-checks staged text files with codespell before allowing a commit.
set -euo pipefail

if ! command -v codespell >/dev/null 2>&1; then
  echo "warning: codespell not installed, skipping spell check (install with: sudo apt install codespell)" >&2
  exit 0
fi

files=$(git diff --cached --name-only --diff-filter=ACM -- '*.md' '*.markdown' '*.html' '*.yml' '*.yaml')

if [ -z "$files" ]; then
  exit 0
fi

if ! codespell --config .codespellrc $files; then
  echo "" >&2
  echo "codespell found possible typos in staged files (see above)." >&2
  echo "Fix them, or if a flagged word is intentional, add it to ignore-words-list in .codespellrc." >&2
  exit 1
fi
